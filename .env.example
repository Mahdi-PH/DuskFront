# ---------------------------------------------------------------------------
# Velocity Island — environment configuration
# Copy this file to .env and adjust as needed. `docker compose up` reads .env
# from the repo root automatically.
# ---------------------------------------------------------------------------

# --- Database (apps/server, database/prisma) ---
POSTGRES_USER=velocity
POSTGRES_PASSWORD=velocity
POSTGRES_DB=velocity_island
# Used by Prisma. Inside docker compose the host is the service name "postgres";
# from your own machine (running the server outside Docker) use "localhost".
DATABASE_URL=postgresql://velocity:velocity@postgres:5432/velocity_island

# --- Redis (apps/server: Colyseus presence/driver + matchmaking) ---
REDIS_URL=redis://redis:6379

# --- Auth (apps/server) ---
# Generate real secrets for anything beyond local development, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev_access_secret_change_me_please_32chars
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_please_32chars
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000

# --- Server ---
NODE_ENV=development
PORT=2567
# Comma-separated list, or * for local development only.
CORS_ORIGIN=*

# --- Client (apps/client) ---
# Where the browser should reach the server. When running docker compose on
# your own machine these can stay as localhost; change them to your deployed
# server's hostname in production.
VITE_SERVER_HTTP_URL=http://localhost:2567
VITE_SERVER_WS_URL=ws://localhost:2567
