{
  "name": "velocity-island",
  "private": true,
  "version": "0.1.0",
  "description": "Velocity Island - 3D Arcade Kart Racing",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:client": "npm run dev -w apps/client",
    "dev:server": "npm run dev -w apps/server",
    "build": "npm run build -w packages/shared && npm run build -w apps/client && npm run build -w apps/server",
    "build:shared": "npm run build -w packages/shared",
    "build:client": "npm run build -w apps/client",
    "build:server": "npm run build -w apps/server",
    "typecheck": "npm run typecheck -w packages/shared && npm run typecheck -w apps/client && npm run typecheck -w apps/server",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate --schema database/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema database/prisma/schema.prisma"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@playwright/test": "^1.47.0",
    "eslint": "^8.57.0",
    "prisma": "^5.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
